# Security Headers for J7 Creations
# Cloudflare Pages security configuration

/*
  # Prevent clickjacking attacks
  X-Frame-Options: DENY
  
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  
  # HTTP already 301s to HTTPS, but only after a request has been made in the
  # clear. HSTS means the browser upgrades before sending anything at all.
  # No `preload` on purpose: that ships the domain to a hardcoded browser list
  # and is painful to undo. No `includeSubDomains` while www is unresolved.
  Strict-Transport-Security: max-age=31536000
  
  # Isolate the browsing context from anything a link opens.
  Cross-Origin-Opener-Policy: same-origin
  
  # Enable XSS filter in browsers
  X-XSS-Protection: 1; mode=block
  
  # Referrer policy - only send origin for cross-origin requests
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Content Security Policy - restrict resource loading.
  # static.cloudflareinsights.com is here because Cloudflare injects its Web
  # Analytics beacon into every page. Without it the script is blocked, which
  # logged a CSP violation on every page load and meant the analytics feature
  # was switched on in the dashboard while collecting nothing.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://analytics.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; media-src 'self' blob:; connect-src 'self' https://formspree.io https://analytics.google.com https://www.google-analytics.com https://cloudflareinsights.com; frame-src 'self' https://www.google.com https://maps.google.com;
  
  # Permissions Policy - disable unnecessary browser features
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  
  # NO Cache-Control here. This block matches EVERY file, and Cloudflare Pages
  # merges matching rules instead of overriding, so anything set here is
  # concatenated onto the per-type rules below — leaving images and video with
  # two conflicting max-age values in a single header. HTML gets its own
  # revalidation rules at the bottom of this file instead.

# Cache static assets aggressively.
#
# NOTE: "immutable" is only safe for files whose NAME changes when their
# content changes. This site has no build step, so nothing is content-hashed
# automatically — which is why JavaScript and CSS are deliberately excluded
# below.
#
# Images and video ARE cached hard, so they carry a content hash in the
# filename (e.g. waterproof-box-view1.c983b9a8.jpg). If you edit an image,
# you MUST give it a new hash or the edge will keep serving the old bytes
# for a year. Editing one in place and keeping the name does not work — the
# deploy succeeds and visitors still see the old picture.
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Video inherits max-age=0 from the /* block otherwise, which means 17.5 MB of
# MP4 revalidates on every page view. Filenames are stable, so cache hard.
/*.mp4
  Cache-Control: public, max-age=31536000, immutable

/*.webm
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be revalidated. Cached with a long TTL it can
# never replace itself, which strands every returning visitor on whatever
# version of the site their worker last cached.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Scripts and styles are not content-hashed, so they must revalidate too.
# js/pricing.js holds every price on the site — if it is cached hard, a price
# change never reaches anyone who has visited before. Revalidation is cheap:
# unchanged files return a 304 with no body.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Never cache the not-found page. Without a real 404, Cloudflare Pages answers
# a missing asset with 200 + the homepage HTML — and because the URL still ends
# in .jpg, the immutable rule above then pins that HTML to the image URL for a
# year. One typo in an image path becomes a year-long broken image.
/404.html
  Cache-Control: no-store

# HTML must always revalidate, and with clean URLs it has no extension to match
# on — so the routes are listed explicitly rather than caught by /*.
/
  Cache-Control: public, max-age=0, must-revalidate

/pages/*
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The repo deploys wholesale, so working files are reachable over HTTP. They
# hold no secrets, but there is no reason for a maintenance document or a build
# script to sit in search results.
/HANDOFF.md
  X-Robots-Tag: noindex, nofollow

/scripts/*
  X-Robots-Tag: noindex, nofollow

/README.md
  X-Robots-Tag: noindex, nofollow
